# Local Python environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.env
.env.*
!.env.example

# Regenerable datasets (keep existing upstream example WAVs)
/noise_dataset/
/SFANC_NoFeedback/noise_dataset/

# Feedback-aware experiments are outside this upload scope.
# Preserve all files locally.
/SFANC_Feedback_Training/
/SFANC_NoFeedback/SFANC_Feedback_Training/
/train_sfanc_feedback_1dcnn.py
/SFANC_NoFeedback/train_sfanc_feedback_1dcnn.py

# Intermediate pretraining checkpoint
/Trained models/*_partial.mat
/SFANC_NoFeedback/Trained models/*_partial.mat

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# TI Code Composer Studio generated output and machine-local launch metadata
/firmware/*/Debug/
/firmware/*/Release/
/firmware/*/.config/
/firmware/*/.launches/
/firmware/*/src/
/firmware/*/*.bak

# Runtime outputs
/runtime/*.wav
/runtime/*.csv

# Preserved pre-reorganization local duplicates (never uploaded)
/.local-backup/
